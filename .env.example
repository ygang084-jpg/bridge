# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git 에 올라가지 않는다.
#
# ⚠ 절대 VITE_ / NEXT_PUBLIC_ 접두사를 붙이지 말 것.
#   그 접두사가 붙은 값은 브라우저 번들에 그대로 박혀 나간다.
#   serverClient.js 가 접두사 붙은 서비스 롤 키를 발견하면 즉시 예외를 던진다.

# 사이트의 절대 주소 (프로토콜 포함, 끝에 슬래시 없이).
#   sitemap.xml · robots.txt 는 규격상 절대 URL 을 요구한다 — src/lib/siteUrl.js.
#   비워 두면 버셀이 넣어 주는 VERCEL_PROJECT_PRODUCTION_URL 을 쓰고,
#   로컬에서는 http://localhost:3000 으로 떨어진다. 커스텀 도메인을 붙였을 때만 채운다.
SITE_URL=

# Supabase — 프로젝트 설정 > API 에서 확인
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 스케줄러 라우트 보호용 토큰. 아무 긴 랜덤 문자열이면 된다.
# Vercel Cron 은 요청에 Authorization: Bearer <CRON_SECRET> 을 붙여 보낸다.
CRON_SECRET=

# 카카오 지도 JavaScript 키 — https://developers.kakao.com
#   내 애플리케이션 → 앱 키 → JavaScript 키
#   그리고 앱 설정 → 플랫폼 → Web → 사이트 도메인에 접속 주소를 등록해야 한다.
#     개발  http://localhost:3000   (거부되면 http://127.0.0.1:3000)
#     배포  https://<프로젝트>.vercel.app
#
# ⚠ 이 키만 NEXT_PUBLIC_ 접두사를 쓴다. 지도 SDK 는 브라우저에서 돌아야 하고,
#   JS 키는 설계상 공개되는 값이다 — 보호 장치는 비밀이 아니라 위에 등록한
#   사이트 도메인이다. REST API 키를 여기 넣으면 안 된다 (도메인 제한이 없다).
#   비어 있으면 지도 대신 격자 배경 + 상대 위치 마커로 표시된다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 네이버 뉴스 검색 API — https://developers.naver.com/apps 에서 앱 등록 후
# '검색' API 를 추가하면 발급된다. 서버(스케줄러)에서만 쓰고 브라우저로 내보내지 않는다.
# 비어 있으면 /api/cron/refresh-news 가 503 으로 멈춘다 (조용히 지나가지 않는다).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
