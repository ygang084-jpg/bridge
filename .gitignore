# 환경변수 — 저장소 루트에도 .gitignore 가 있어야 한다.
# bridge-guardian/.gitignore 는 그 폴더 안만 막기 때문에, 루트에 만든 .env 는
# 그대로 커밋된다. 실제로 그런 상태였고(검수 2026-08-18) 이 파일로 막았다.
.env
.env.*
!.env.example

# 의존성 · 빌드 산출물
node_modules/
.next/
out/
dist/
build/

# 로그
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 배포 도구
.vercel/

# 에디터 · OS
.DS_Store
Thumbs.db
.idea/
*.swp
